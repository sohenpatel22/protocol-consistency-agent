# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: Cohere embeddings (the paper's retriever). Without it, BM25 is used.
COHERE_API_KEY=

# "paper" = the models named in the paper (2025); "current" = current models.
AGENT_PROFILE=paper

# Optional per-role overrides, format "<provider>:<model>", e.g.
# AGENT_MODEL_EXTRACTOR=anthropic:claude-sonnet-4-5
# AGENT_MODEL_SOE_VISION=anthropic:claude-opus-4-5
# AGENT_MODEL_BASELINE=openai:gpt-4o
# AGENT_MODEL_JUDGE=openai:gpt-4o
# AGENT_MODEL_ANNOTATOR_A=openai:gpt-4o
# AGENT_MODEL_ANNOTATOR_B=anthropic:claude-haiku-4-5
# AGENT_MODEL_ADJUDICATOR=openai:gpt-5
# AGENT_MODEL_VERIFIER=anthropic:claude-opus-5-5
# AGENT_EMBEDDINGS=cohere:embed-v4.0   # or "bm25"

# Not in the paper: ask the extractor for a page and quote per field (1 = on)
AGENT_FIELD_CITATIONS=0

# Claude on AWS Bedrock (uses your AWS credentials), for example:
# AGENT_MODEL_EXTRACTOR=bedrock:<bedrock model id for Claude Sonnet 4.5>
